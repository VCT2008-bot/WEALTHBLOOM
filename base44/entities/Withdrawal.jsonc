{
  "name": "Withdrawal",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "investment_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "service_fee": {
      "type": "number",
      "default": 50
    },
    "net_payout": {
      "type": "number",
      "default": 0
    },
    "withdrawal_type": {
      "type": "string",
      "enum": [
        "early",
        "matured"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "processing",
        "completed",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_note": {
      "type": "string"
    },
    "processed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "investment_id",
    "amount",
    "withdrawal_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}