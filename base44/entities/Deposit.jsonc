{
  "name": "Deposit",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "investment_amount": {
      "type": "number",
      "default": 0
    },
    "service_fee": {
      "type": "number",
      "default": 50
    },
    "total_payment": {
      "type": "number",
      "default": 0
    },
    "payment_reference": {
      "type": "string"
    },
    "investment_period": {
      "type": "string",
      "enum": [
        "30_days",
        "90_days",
        "6_months",
        "1_year"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "successful",
        "failed",
        "rejected",
        "refunded"
      ],
      "default": "pending"
    },
    "admin_note": {
      "type": "string"
    },
    "investment_id": {
      "type": "string"
    },
    "processed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "investment_amount",
    "investment_period"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}