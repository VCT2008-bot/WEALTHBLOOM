{
  "name": "InvestmentRate",
  "type": "object",
  "properties": {
    "annual_rate": {
      "type": "number",
      "default": 0
    },
    "monthly_rate": {
      "type": "number",
      "default": 0
    },
    "daily_rate": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "default": "Administrator-configured rate"
    },
    "effective_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "current",
        "historical"
      ],
      "default": "current"
    },
    "created_by": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "previous_rate": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "annual_rate",
    "source"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}